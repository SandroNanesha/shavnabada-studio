generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Studio {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())

  users            User[]
  locations        Location[]
  groups           Group[]
  teachers         Teacher[]
  tags             Tag[]
  classifications  PaymentClassification[]
  pupils           Pupil[]
  applicationForms ApplicationForm[]
  applications     Application[]
  settings         Settings?
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         UserRole @default(studio_admin)
  studioId     String?
  studio       Studio?  @relation(fields: [studioId], references: [id])
  createdAt    DateTime @default(now())
}

model Location {
  id       String   @id @default(cuid())
  name     String
  studioId String
  studio   Studio   @relation(fields: [studioId], references: [id])
  groups   Group[]
}

model Group {
  id         String   @id @default(cuid())
  name       String
  locationId String
  location   Location @relation(fields: [locationId], references: [id])
  studioId   String
  studio     Studio   @relation(fields: [studioId], references: [id])

  enrollments Enrollment[]
  teachers    TeacherGroup[]
}

model Teacher {
  id       String         @id @default(cuid())
  name     String
  contact  String         @default("")
  role     TeacherRole    @default(Assistant)
  studioId String
  studio   Studio         @relation(fields: [studioId], references: [id])
  groups   TeacherGroup[]
}

model TeacherGroup {
  teacherId String
  groupId   String
  teacher   Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  group     Group   @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([teacherId, groupId])
}

model Tag {
  id       String     @id @default(cuid())
  label    String
  studioId String
  studio   Studio     @relation(fields: [studioId], references: [id])
  pupils   PupilTag[]
}

model PaymentClassification {
  id       String                    @id @default(cuid())
  name     String
  type     PaymentClassificationType
  value    Float
  studioId String
  studio   Studio                    @relation(fields: [studioId], references: [id])

  enrollments Enrollment[]
}

model Pupil {
  id        String        @id @default(cuid())
  firstName String
  surname   String
  idNumber  String
  birthDate String        @default("")
  category  PupilCategory @default(standard)
  condition String        @default("")
  archived  Boolean       @default(false)
  source    PupilSource   @default(manual)
  studioId  String
  studio    Studio        @relation(fields: [studioId], references: [id])

  parents     PupilParent[]
  notes       PupilNote[]
  tags        PupilTag[]
  enrollments Enrollment[]
  payments    Payment[]

  @@unique([studioId, idNumber])
}

model PupilParent {
  id      String @id @default(cuid())
  pupilId String
  name    String
  phone   String @default("")
  order   Int    @default(0)
  pupil   Pupil  @relation(fields: [pupilId], references: [id], onDelete: Cascade)
}

model PupilNote {
  id      String @id @default(cuid())
  pupilId String
  date    String
  text    String
  pupil   Pupil  @relation(fields: [pupilId], references: [id], onDelete: Cascade)
}

model PupilTag {
  pupilId String
  tagId   String
  pupil   Pupil  @relation(fields: [pupilId], references: [id], onDelete: Cascade)
  tag     Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([pupilId, tagId])
}

model Enrollment {
  id             String  @id @default(cuid())
  pupilId        String
  groupId        String
  startDate      String
  endDate        String?
  baseFee        Float
  discount       Float   @default(0)
  classificationId String?
  customTerms    String  @default("")
  billingActive  Boolean @default(true)
  prorateFirstMonth Boolean @default(false)

  // Per-month overrides stored as JSON objects (YYYY-MM -> value)
  monthOverrides           Json @default("{}")
  monthPaidAmountOverrides Json @default("{}")
  monthDueOverrides        Json @default("{}")
  ledgerComments           Json @default("{}")

  // History stored as JSON arrays
  groupHistory           Json @default("[]")
  classificationHistory  Json @default("[]")

  pupil          Pupil                  @relation(fields: [pupilId], references: [id], onDelete: Cascade)
  group          Group                  @relation(fields: [groupId], references: [id])
  classification PaymentClassification? @relation(fields: [classificationId], references: [id])
  payments       Payment[]
}

model Payment {
  id           String @id @default(cuid())
  pupilId      String
  enrollmentId String
  amount       Float
  date         String

  pupil      Pupil      @relation(fields: [pupilId], references: [id], onDelete: Cascade)
  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
}

model ApplicationForm {
  id                 String   @id @default(cuid())
  title              String
  slug               String   @unique
  fields             Json     @default("[]")
  disabledPredefined Json     @default("[]")
  active             Boolean  @default(true)
  createdAt          DateTime @default(now())
  studioId           String
  studio             Studio   @relation(fields: [studioId], references: [id])

  applications Application[]
}

model Application {
  id               String            @id @default(cuid())
  pupilFirstName   String
  pupilSurname     String
  birthDate        String
  idNumber         String            @default("")
  documentFilename String?
  status           ApplicationStatus @default(pending)
  submittedAt      String
  formId           String?
  form             ApplicationForm?  @relation(fields: [formId], references: [id])
  studioId         String
  studio           Studio            @relation(fields: [studioId], references: [id])

  parents      ApplicationParent[]
  customValues ApplicationCustomValue[]
}

model ApplicationParent {
  id            String      @id @default(cuid())
  applicationId String
  name          String
  phone         String      @default("")
  order         Int         @default(0)
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
}

model ApplicationCustomValue {
  id            String      @id @default(cuid())
  applicationId String
  label         String
  value         String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
}

model Settings {
  id            String  @id @default(cuid())
  studioName    String  @default("Shavnabada Studio")
  futureMonths  Int     @default(2)
  paymentDueDay Int     @default(1)
  platformLogo  String  @default("")
  formLogo      String  @default("")
  studioId      String  @unique
  studio        Studio  @relation(fields: [studioId], references: [id])
}

enum TeacherRole {
  Principal
  Assistant
}

enum PupilCategory {
  standard
  staff
  social
  flagged
}

enum PaymentClassificationType {
  standard
  percent
  amount
  fixed
}

enum ApplicationStatus {
  pending
  approved
  dismissed
}

enum PupilSource {
  manual
  application
}

enum UserRole {
  super_admin
  studio_admin
}
